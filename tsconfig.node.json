{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "outDir": "./out",
    "declaration": true,
    "composite": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@music-player/core": ["packages/core/src/index.ts"],
      "@music-player/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "electron.vite.config.ts", "packages/core/src/platform.ts"]
}
