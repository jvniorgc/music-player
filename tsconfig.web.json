{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "outDir": "./out",
    "declaration": true,
    "composite": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/renderer/*"],
      "@test/*": ["test/*"],
      "@music-player/core": ["packages/core/src/index.ts"],
      "@music-player/core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/renderer/**/*", "packages/core/src/**/*", "test/**/*"]
}
